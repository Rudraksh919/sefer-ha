# Copy this file to .env and set a real OpenRouter API key locally.
# Never commit the resulting .env file.
OPENROUTER_API_KEY=

# A vision-capable model is needed for scanned PDFs and photos. Pin one for repeatable results
# (openrouter/free picks a different, often weaker model on each call).
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local API port. Vite proxies /api to this port in development.
PORT=8787

# Optional API override for a separately hosted frontend.
# VITE_API_BASE_URL=
