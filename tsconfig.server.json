{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "server/**/*.ts", "src/lib/extraction.ts", "src/lib/netchb-renderer.ts", "src/lib/shipment.ts"]
}
